# Auth (бэкенд + скопировать в frontend/.env как PUBLIC_SMARTCRM_API_KEY)
# SMARTCRM_API_KEY=dev-local-key

# LLM
GROQ_API_KEY=your_groq_api_key

# Whisper (Groq): whisper-large-v3-turbo | whisper-large-v3
WHISPER_MODEL=whisper-large-v3-turbo
WHISPER_LANGUAGE=ru
WHISPER_TEMPERATURE=0
# Словарь для prompt (русский текст, через запятую — свои компании/имена)
# WHISPER_PROMPT=...
# Нормализация ffmpeg: 16 kHz mono + фильтры (нужен ffmpeg в PATH)
WHISPER_FFMPEG_PREPROCESS=1
# WHISPER_FFMPEG_PATH=ffmpeg
# WHISPER_FFMPEG_AF=highpass=f=80,loudnorm=I=-16:TP=-1.5:LRA=11

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
HERMES_MODEL=hermes3:latest

# Database (лучше 127.0.0.1 вместо localhost на Windows — иначе asyncpg может ловить RST на ::1)
DATABASE_URL=postgresql+asyncpg://smartcrm:smartcrm@127.0.0.1:5432/smartcrm
# Опционально: pool_recycle в секундах (по умолчанию 280). Уменьшает 500 после обрыва TCP к Postgres.
# DATABASE_POOL_RECYCLE_SEC=280
# Таймаут установления TCP к Postgres, сек (по умолчанию 30).
# DATABASE_CONNECT_TIMEOUT=30
# Автозамена @localhost -> @127.0.0.1 в URL (по умолчанию включено). Отключить: DATABASE_FORCE_IPV4=0
# Для локального Postgres без TLS: DATABASE_SSL=disable

# Redis
REDIS_URL=redis://localhost:6379

# Search
BRAVE_API_KEY=your_brave_api_key
TAVILY_API_KEY=your_tavily_api_key
SERPER_API_KEY=your_serper_api_key
# TTL кэша полного результата enrich (company+ИНН+industry), часы
ENRICH_CACHE_TTL_HOURS=24
# Опц. LLM для auto-ingest Q&A (0=эвристика, 1=Groq/Ollama)
RAG_AUTO_STRUCTURE_LLM=0
# Опц. LLM для фактов из диалога агента (0=эвристика)
RAG_DIALOGUE_LLM=0

# Лидогенерация
CHECKO_API_KEY=MXoenGKRZ0QJlXvE
HUNTER_API_KEY=your_hunter_api_key
APOLLO_API_KEY=your_apollo_api_key
BUILTWITH_API_KEY=d7d3aada-840c-4dcd-96af-8549e43bb76d
NEWS_API_KEY=26b947400536426a9aeeb6edfe85f1c5
BUSTER_API_KEY=your_buster_api_key
FNS_API_KEY=e4fb4b0495eb79ed9d614d3f0c8da15453245bee

# Chroma RAG (локальная персистентность; не сервер CHROMA_HOST)
CHROMA_PERSIST_DIR=data/chroma_db
RAG_ENABLED=1
RAG_TOP_K=5
RAG_CHUNK_MAX_CHARS=1800
RAG_CHUNK_MIN_CHARS=400
RAG_OVERLAP_SENTENCES=2
# Авто-чанки Search→RAG: минимальный relevance score (0–100)
RAG_AUTO_RELEVANCE_THRESHOLD=65
# Авто-ингест фактов из диалога агента (1=вкл после run/fanout)
RAG_DIALOGUE_AUTO_INGEST=1
RAG_DIALOGUE_MIN_FACTS=2
RAG_XLSX_ROWS_PER_BLOCK=12
# PDF: в venv обязательно pip install pypdf (или PyPDF2 как запасной вариант)

# Битрикс24 (входящий вебхук: CRM + user + **task**; базовый URL до секрета, со слэшем в конце)
# Права вебхука: crm (лиды), user (имена ответственных), task (tasks.task.list — встречи/задачи).
# Проверка: cd backend && python scripts/check_bitrix_webhook_scopes.py
# Файл .env в корне репозитория SmartCRM подхватывается даже при запуске uvicorn из папки backend/
# Пример: https://ваш-портал/rest/112/ваш_секрет/
BITRIX24_WEBHOOK_URL=
# Авто-опрос новых лидов (DATE_CREATE >= сегодня), минуты; 0 = выкл. По умолчанию 5 при заданном URL.
BITRIX_AUTO_SYNC_MINUTES=5
# Догонка: лиды с DATE_MODIFY за N дней + пачка локальных bitrix_lead_id за цикл опроса
BITRIX_SYNC_MODIFY_DAYS=30
BITRIX_SYNC_BATCH_SIZE=25
# Лимит REST при mass-resync (опционально)
BITRIX_MAX_CONCURRENT=2
BITRIX_MIN_CALL_INTERVAL_SEC=0.1
# Токен исходящего вебхука Битрикс24 (ONCRMLEADADD) — ?token=... или auth[application_token]
BITRIX_OUTBOUND_TOKEN=

# AmoCRM API v4 (импорт/экспорт лидов)
AMO_SUBDOMAIN=
AMO_ACCESS_TOKEN=

# HubSpot private app (сделки /crm/v3/objects/deals)
HUBSPOT_ACCESS_TOKEN=

# Email — live smoke (backend/scripts/smoke_email_connect.py) и ручной connect
# Пароль приложения: https://id.yandex.ru/security/app-passwords (не пароль от аккаунта)
# EMAIL_APP_PASSWORD=
# EMAIL_IMAP_HOST=imap.yandex.com
# EMAIL_IMAP_PORT=993
# EMAIL_SMTP_HOST=smtp.yandex.com
# EMAIL_SMTP_PORT=465
# EMAIL_USE_SSL=1
# EMAIL_ACCOUNT_1_NAME=Рабочая почта
# EMAIL_ACCOUNT_1_USER=you@yandex.ru
# EMAIL_ACCOUNT_1_APP_PASSWORD=...   # свой пароль, если не Яндекс app-password
# EMAIL_ACCOUNT_1_IMAP_HOST=imap.yandex.com   # me@agneko.am — MX на Яндекс; Hostland webmail ≠ IMAP
# EMAIL_ACCOUNT_1_INSECURE_SSL=1              # только самоподписанный IMAP (не Яндекс)
# EMAIL_IMAP_FETCH_LIMIT=500
# EMAIL_IMAP_SINCE_DAYS=30
# EMAIL_CONNECT_ONLY=2  # smoke: только второй аккаунт
# EMAIL_AUTO_SYNC_MINUTES=5  # фоновый IMAP-синк; 0 = выкл

# Автономный поиск лидов (Ф3): фон + /api/ops/lead-hunt/*
# LEAD_HUNT_ENABLED=0
# LEAD_HUNT_INTERVAL_HOURS=24

# SLA: фоновая эскалация просроченных задач (минуты; 0 = выкл)
# SLA_ESCALATION_POLL_MINUTES=5
# EMAIL_INSECURE_SSL_HOSTS=mail.example.am  # hostname mismatch / self-signed
# Bootstrap без UI: GET /api/email/config/status, POST /api/email/bootstrap-from-env

# Тендеры (TenderGuru, Gosplan, DataNewton)
# TENDERGURU_API_KEY=
# DATANEWTON_API_KEY=
# GOSPLAN_USE_PROD=0          # 1 = v2.gosplan.info (prod)
# TENDER_PROVIDER=legacy      # kontur — только после gate (Ф4)
# TENDER_SEARCH_MIN_RELEVANCE=15

# Telegram-бот (уведомления, @SmartCRM_agent_bot)
# TELEGRAM_BOT_TOKEN=          # API token из @BotFather
# TELEGRAM_CHAT_ID=            # chat.id из getUpdates после /start боту
# TELEGRAM_NOTIFY_ENABLED=1    # исходящие уведомления (lead hunt)
# TELEGRAM_POLL_ENABLED=1      # long polling /start /status /queue
# TELEGRAM_ALLOWED_CHAT_IDS=   # опционально: доп. chat_id через запятую

# App
APP_SECRET_KEY=change_me_in_production
DEBUG=true
